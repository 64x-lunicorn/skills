{
  "name": "64x-lunicorn-skills",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Skills as code for Claude Code: harvested from real corrections, enforced by a validator",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate": "node tools/validator/src/cli.ts .",
    "scenarios": "node tools/scenarios/src/cli.ts",
    "ci": "npm run validate && npm run typecheck && npm run coverage",
    "changeset": "changeset",
    "version": "changeset version && node tools/release/sync-plugin-version.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
